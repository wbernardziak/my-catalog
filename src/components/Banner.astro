---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

const variantClass: Record<Variant, string> = {
  info: "border-primary bg-surface-subtle text-foreground",
  warning: "border-warning bg-warning-tint text-warning-ink",
  error: "border-destructive bg-destructive-tint text-destructive-ink",
};
---

{
  /* Tokenised in the phase 3 sweep: the old `<style>` block hardcoded six hex
values, so the banner ignored the theme entirely. */
}
<div
  class:list={[
    "border-b px-4 py-3 text-center text-sm [&_a]:font-semibold [&_a]:text-inherit [&_a]:underline",
    variantClass[variant],
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
