---
/**
 * The MyCatalog mark: a brass meeple on a felt tile.
 *
 * Fixed colours by design — a logo keeps its identity across themes, so this is
 * the one component besides `global.css` exempt from the colour-literal guard.
 * Kept in sync by hand with `public/favicon.svg`.
 */
interface Props {
  /** Rendered size in px. Legible down to 24. */
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  role="img"
  aria-label="MyCatalog"
  class:list={[className]}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="1" y="1" width="30" height="30" rx="7" fill="#16302a" stroke="#c8a24a" stroke-width="1.5"></rect>
  <path
    d="M16 6.6a3 3 0 0 1 2.3 4.93c2.2.62 3.9 2.2 4.5 4.27.2.7-.35 1.3-1.05 1.3h-2.4l.9 6.1c.08.6-.38 1.2-1 1.2h-6.5c-.62 0-1.08-.6-1-1.2l.9-6.1H10.3c-.7 0-1.25-.6-1.05-1.3.6-2.07 2.3-3.65 4.5-4.27A3 3 0 0 1 16 6.6Z"
    fill="#c8a24a"></path>
</svg>
