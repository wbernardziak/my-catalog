---
/**
 * The page `<h1>`. Split out of `AppHeader` when the header moved to `Layout`:
 * the bar is full-bleed and shared, the title belongs inside each page's own
 * content container, so they could no longer be one component.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<h1 class="from-primary to-secondary mb-8 bg-gradient-to-r bg-clip-text text-3xl font-bold text-transparent">
  {title}
</h1>
