---
import type { GameFilters } from "@/types";

interface Props {
  genres: string[];
  current: GameFilters;
}

const { genres, current } = Astro.props;

// If an active genre no longer has live rows (a stale/hand-edited ?genre=), keep
// it as an option so the control reflects the active filter instead of silently
// falling back to "All genres".
const genreOptions = current.genre && !genres.includes(current.genre) ? [...genres, current.genre] : genres;

const inputClass =
  "w-full rounded-lg border border-border bg-surface-subtle px-3 py-2 text-sm text-foreground placeholder:text-ink-muted focus:border-ring focus:outline-none";
const labelClass = "mb-1 block text-xs font-medium text-ink-muted";
---

<form
  method="GET"
  action="/catalog"
  aria-label="Filter games"
  class="border-border bg-card text-foreground mb-6 rounded-2xl border p-4 backdrop-blur-xl"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <label class:list={labelClass} for="filter-genre">Genre</label>
      <select id="filter-genre" name="genre" class:list={inputClass}>
        <option value="">All genres</option>
        {
          genreOptions.map((genre) => (
            <option value={genre} selected={genre === current.genre}>
              {genre}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label class:list={labelClass} for="filter-players">Party of</label>
      <input
        id="filter-players"
        type="number"
        name="players"
        min="1"
        max="99"
        placeholder="Any"
        value={current.players ?? ""}
        class:list={inputClass}
      />
    </div>

    <div>
      <label class:list={labelClass} for="filter-max-minutes">Max minutes</label>
      <input
        id="filter-max-minutes"
        type="number"
        name="maxMinutes"
        min="1"
        max="6000"
        placeholder="Any"
        value={current.maxMinutes ?? ""}
        class:list={inputClass}
      />
    </div>

    <div>
      <label class:list={labelClass} for="filter-loan">Loan status</label>
      <select id="filter-loan" name="loan" class:list={inputClass}>
        <option value="">All</option>
        <option value="available" selected={current.loanStatus === "available"}>Available</option>
        <option value="loaned" selected={current.loanStatus === "loaned"}>Loaned</option>
      </select>
    </div>

    <div>
      <label class:list={labelClass} for="filter-played">Played</label>
      <select id="filter-played" name="played" class:list={inputClass}>
        <option value="">All</option>
        <option value="true" selected={current.played === true}>Played</option>
        <option value="false" selected={current.played === false}>Not played</option>
      </select>
    </div>

    <div>
      <label class:list={labelClass} for="filter-preference">Preference</label>
      <select id="filter-preference" name="preference" class:list={inputClass}>
        <option value="">All</option>
        <option value="liked" selected={current.preference === "liked"}>Liked</option>
        <option value="disliked" selected={current.preference === "disliked"}>Disliked</option>
      </select>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      type="submit"
      class="bg-primary text-primary-foreground rounded-lg px-4 py-2 text-sm font-medium transition-colors hover:opacity-90"
    >
      Apply filters
    </button>
    <a href="/catalog" class="text-primary text-sm hover:underline">Clear</a>
  </div>
</form>
