---
import type { MemberStat } from "@/types";

interface Props {
  stats: MemberStat[];
}

const { stats } = Astro.props;

// Rows are the three metrics; columns are the members. Kept as static config so
// the markup stays a plain map over stats.
const metrics: { key: "playedCount" | "likedCount" | "dislikedCount"; label: string }[] = [
  { key: "playedCount", label: "Played" },
  { key: "likedCount", label: "Liked" },
  { key: "dislikedCount", label: "Disliked" },
];

const headerCell = "px-4 py-3 text-left text-xs font-medium tracking-wide text-ink-muted uppercase";
const bodyCell = "px-4 py-3 text-sm text-foreground";
---

<div class="border-border bg-card overflow-x-auto rounded-2xl border backdrop-blur-xl">
  <table class="w-full border-collapse">
    <thead>
      <tr class="border-border border-b">
        <th scope="col" class:list={headerCell}>Metric</th>
        {
          stats.map((member) => (
            <th scope="col" class:list={[headerCell, member.isCurrent && "text-primary"]}>
              {member.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        metrics.map((metric) => (
          <tr class="border-border border-b last:border-b-0">
            <th scope="row" class:list={[bodyCell, "text-ink-muted font-medium"]}>
              {metric.label}
            </th>
            {stats.map((member) => (
              <td class:list={[bodyCell, member.isCurrent && "text-primary font-semibold"]}>{member[metric.key]}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
