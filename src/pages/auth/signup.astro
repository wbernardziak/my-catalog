---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="flex flex-1 items-center justify-center">
    <div class="border-border bg-card text-foreground w-full max-w-sm rounded-2xl border p-8 backdrop-blur-xl">
      {
        /* Solid, not the `PageTitle` gradient: those stops are picked against the page
          ground, and this heading sits on a card. */
      }
      <h1 class="text-foreground mb-6 text-center text-2xl font-bold">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-ink-muted mt-4 text-center text-sm">
        Already have an account? <a href="/auth/signin" class="text-accent-ink hover:underline">Sign in</a>
      </p>
    </div>
  </div>
</Layout>
