---
import Layout from "@/layouts/Layout.astro";
import AddGameForm from "@/components/catalog/AddGameForm";
import { createClient } from "@/lib/supabase";
import { listGames } from "@/lib/services/games";
import type { GameRow } from "@/types";

const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);
let games: GameRow[] = [];
let configured = true;

if (supabase) {
  games = await listGames(supabase);
} else {
  configured = false;
}
---

<Layout title="Catalog">
  <div class="bg-cosmic min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-5xl">
      <header class="mb-8 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Catalog
        </h1>
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">← Dashboard</a>
      </header>

      {
        !configured ? (
          <div class="rounded-2xl border border-red-500/30 bg-red-900/20 p-6 text-red-200">
            Supabase is not configured — the catalog is unavailable. Set <code>SUPABASE_URL</code> and{" "}
            <code>SUPABASE_KEY</code> to enable it.
          </div>
        ) : (
          <div class="grid gap-8 md:grid-cols-[1fr_360px]">
            <section aria-label="Games">
              {games.length === 0 ? (
                <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-blue-100/70">
                  No games yet. Add your first board game using the form.
                </div>
              ) : (
                <ul class="space-y-3">
                  {games.map((game) => (
                    <li class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl">
                      <div class="flex items-start justify-between gap-3">
                        <h2 class="text-lg font-semibold">{game.title}</h2>
                        <span
                          class:list={[
                            "rounded-full px-2 py-0.5 text-xs font-medium",
                            game.loan_status === "loaned"
                              ? "bg-amber-500/20 text-amber-200"
                              : "bg-emerald-500/20 text-emerald-200",
                          ]}
                        >
                          {game.loan_status === "loaned" ? "Loaned" : "Available"}
                        </span>
                      </div>
                      {game.authors.length > 0 && (
                        <p class="mt-1 text-sm text-blue-100/70">{game.authors.join(", ")}</p>
                      )}
                      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/80">
                        <span>{game.genre}</span>
                        <span>
                          {game.min_players}–{game.max_players} players
                        </span>
                        <span>~{game.avg_play_minutes} min</span>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            <aside
              aria-label="Add a game"
              class="h-fit rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl"
            >
              <h2 class="mb-4 text-lg font-semibold">Add a game</h2>
              <AddGameForm serverError={error} client:load />
            </aside>
          </div>
        )
      }
    </div>
  </div>
</Layout>
