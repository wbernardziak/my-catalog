---
import Layout from "@/layouts/Layout.astro";
import PageTitle from "@/components/PageTitle.astro";
import GameForm from "@/components/catalog/GameForm";
import GameCard from "@/components/catalog/GameCard";
import CatalogFilters from "@/components/catalog/CatalogFilters.astro";
import { createClient } from "@/lib/supabase";
import { listGenres } from "@/lib/services/games";
import { listCatalogGames } from "@/lib/services/catalogGames";
import { parseGameFilters, serializeGameFilters } from "@/lib/services/gameFilters";
import type { CatalogGame } from "@/types";

const error = Astro.url.searchParams.get("error");

const filters = parseGameFilters(Astro.url.searchParams);
const hasActiveFilters = Object.keys(filters).length > 0;
// Canonical query string for the active filters (no `error`), handed to the cards
// so their toggle PRGs come back to this same filtered view.
const activeQuery = serializeGameFilters(filters).toString();

const supabase = createClient(Astro.request.headers, Astro.cookies);
// Guaranteed by the middleware `PROTECTED_ROUTES` gate, but kept defensive so the
// per-member catalog fetch never runs without a member id.
const user = Astro.locals.user;

let games: CatalogGame[] = [];
let genres: string[] = [];
let configured = true;
let loadError: string | null = null;

if (supabase && user) {
  try {
    [games, genres] = await Promise.all([listCatalogGames(supabase, user.id, filters), listGenres(supabase)]);
  } catch (err) {
    // Log before flattening to copy. The user-facing string is deliberately vague,
    // and discarding the cause left no way to tell a Supabase outage from a module
    // that failed to resolve.
    //
    // Note what this catch does NOT cover: the `GameCard` islands render below,
    // outside the try. An island that throws during SSR aborts the HTML stream
    // instead, so the page truncates after the filters with no error panel at all.
    // Truncated page => rendering/module-graph problem; this panel => a query threw.
    // `no-console` stays a warning project-wide to catch stray debug logs; server-side
    // error reporting is the deliberate exception, and on Workers this is what reaches
    // the log tail.
    // eslint-disable-next-line no-console
    console.error("[catalog] failed to load games or genres", err);
    loadError = "Could not load the catalog. Please try again.";
  }
} else if (!supabase) {
  configured = false;
} else {
  // Unreachable behind the middleware `PROTECTED_ROUTES` gate, but if the session
  // ever resolves to no user we say so instead of rendering an empty catalog that
  // reads as "you own no games".
  loadError = "Your session has expired. Please sign in again.";
}
---

<Layout title="Catalog">
  <div class="mx-auto w-full max-w-5xl">
    <PageTitle title="Catalog" />

    {
      !configured ? (
        <div class="border-destructive/40 bg-destructive-tint text-destructive-ink rounded-2xl border p-6">
          Supabase is not configured — the catalog is unavailable. Set <code>SUPABASE_URL</code> and{" "}
          <code>SUPABASE_KEY</code> to enable it.
        </div>
      ) : (
        <div class="grid gap-8 md:grid-cols-[1fr_360px]">
          <section aria-label="Games">
            <CatalogFilters genres={genres} current={filters} />
            {loadError ? (
              <div class="border-destructive/40 bg-destructive-tint text-destructive-ink rounded-2xl border p-6">
                {loadError}
              </div>
            ) : games.length === 0 ? (
              hasActiveFilters ? (
                <div class="border-border bg-surface-subtle text-ink-muted rounded-2xl border p-8 text-center">
                  No games match your filters.{" "}
                  <a href="/catalog" class="text-accent-ink hover:underline">
                    Clear filters
                  </a>
                </div>
              ) : (
                <div class="border-border bg-surface-subtle text-ink-muted rounded-2xl border p-8 text-center">
                  No games yet. Add your first board game using the form.
                </div>
              )
            ) : (
              <ul class="space-y-3">
                {games.map((game) => (
                  <li>
                    <GameCard game={game} filters={activeQuery} client:load />
                  </li>
                ))}
              </ul>
            )}
          </section>

          <aside
            aria-label="Add a game"
            class="border-border bg-card text-foreground h-fit rounded-2xl border p-6 backdrop-blur-xl"
          >
            <h2 class="mb-4 text-lg font-semibold">Add a game</h2>
            <GameForm mode="create" idPrefix="create" action="/api/games" serverError={error} client:load />
          </aside>
        </div>
      )
    }
  </div>
</Layout>
