---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-table min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-3xl">
      <AppHeader title="Dashboard" />

      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
        <p class="text-blue-100/80">
          Welcome, <span class="font-semibold text-white">{user?.email}</span>
        </p>
        <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href="/catalog"
            class="inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            View catalog
          </a>
          <a
            href="/play"
            class="inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            What should we play?
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
