---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import RecommendationFlow from "@/components/play/RecommendationFlow";

// No server data fetch: the island drives everything via the JSON route. The
// global not-configured banner from Layout still renders automatically if the
// OpenRouter key is missing.
---

<Layout title="What should we play?">
  <div class="bg-cosmic min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-3xl">
      <AppHeader title="What should we play?" />

      <RecommendationFlow client:load />
    </div>
  </div>
</Layout>
